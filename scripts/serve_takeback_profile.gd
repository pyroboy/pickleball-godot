static func apply(pose: PostureDefinition, charge: float) -> PostureDefinition:
	var q: float = clampf(charge, 0.0, 1.0)
	var position: float = q * 20.0
	var index: int = mini(19, int(position))
	var weight: float = position - index
	var basis: Basis = _basis(KEYS[index][1]).slerp(_basis(KEYS[index + 1][1]), weight)
	var head: Vector3 = _curve(index, weight, 0)
	pose.paddle_forehand_mul = head.x;pose.paddle_y_offset = head.y;pose.paddle_forward_mul = head.z
	Orientation.set_canonical_basis(pose, basis)
	pose.right_elbow_pole = _curve(index, weight, 2)
	var body_weight: float = smoothstep(0.0, 1.0, q)
	for field in range(BODY_FIELDS.size()): pose.set(BODY_FIELDS[field], lerpf(BODY_START[field], BODY_FINISH[field], body_weight))
	pose.weight_shift += 0.5 * (1.0 - body_weight)
	pose.shoulder_protraction_m = 0.03 * (1.0 - q)
	return pose

static func _basis(degrees: Vector3) -> Basis:
	var a: Vector3 = degrees * (PI / 180.0)
	return Basis(Vector3.RIGHT, a.x) * Basis(Vector3.UP, a.y) * Basis(Vector3.FORWARD, a.z)

static func _curve(index: int, u: float, channel: int) -> Vector3:
	var a: Vector3 = KEYS[index][channel]; var b: Vector3 = KEYS[index + 1][channel]
	var before: Vector3 = KEYS[maxi(0, index - 1)][channel]
	var after: Vector3 = KEYS[mini(20, index + 2)][channel]
	var m0: Vector3 = b - a if index == 0 else (b - before) * 0.5
	var m1: Vector3 = b - a if index == 19 else (after - a) * 0.5
	return (2 * u * u * u - 3 * u * u + 1) * a + (u * u * u - 2 * u * u + u) * m0 + (-2 * u * u * u + 3 * u * u) * b + (u * u * u - u * u) * m1
